<%# The "Log in with GitHub" button below is a rails-ujs link_to ... method:
    'post'; rails-ujs reads the CSRF token from the <meta name="csrf-token">
    tag, which the layout omits for anonymous users (CDN caching, Change 1).
    Opt back in so the token is present and the POST to /auth/github passes
    CSRF. This page is never CDN-cached, so emitting the tag here is harmless.
    See docs/cdn-cache-not-logged-in.md Section 9.1. %>
<%# Use the non-block form: a content_for block captures the block's *output*,
    and a block returning a bare `true` outputs nothing, so content_for? would
    stay false. A non-empty string value makes content_for? true. %>
<% content_for :needs_csrf_meta, 'true' %>
<% content_for :special_head_values do %>
  <%# same-origin (must NOT be no-referrer):
      Cross-origin requests (e.g. the OmniAuth redirect to github.com) carry
      no Referer, so return_to and pending_resubmission_token never leak to
      GitHub (the privacy goal). Same-origin requests (the form POST to
      /auth/github) still send the real Origin header, so Rails CSRF
      protection passes (the correctness goal). no-referrer would suppress
      Origin too, causing browsers to send "Origin: null"; Rails rejects
      that and OAuth fails with a 404.
      See test/integration/users_login_test.rb for the full step-by-step. %>
  <meta name="referrer" content="same-origin">
<% end %>
<br>
<h1 class='center'><%= t('sessions.login_header') %></h1>

<%# return_to and pending_resubmission_token arrive two different ways
    depending on how this page got rendered: a top-level query param on
    the initial GET (from ApplicationController#redirect_to_login_stashing
    or SessionsController's own return_to redirect), or nested under
    session[...] on a re-render after a failed local login POST, since
    the hidden fields below live inside form_for(:session, ...). Read
    both so a failed attempt's retry still carries them forward, not
    just the first page load. hash_param(:session), not
    params.dig(:session, ...): a crafted request can send session as a
    scalar (params[session]=foo), and a plain String has no #dig method;
    hash_param already guards against that the same way the controller
    itself does. %>
<% return_to_value = params[:return_to] || hash_param(:session)[:return_to] %>
<% pending_resubmission_token_value =
     params[:pending_resubmission_token] ||
     hash_param(:session)[:pending_resubmission_token] %>

<% if Rails.application.config.deny_login %>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <div class="center-block">
       <%= t('sessions.login_disabled') %>
    </div>
  </div>
</div>

<% else %>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
   <div class="center-block">
    <br>
    <br>
    <br>
    <% github_auth_url = "/auth/github?locale=#{locale}" %>
    <% github_auth_url += "&return_to=#{ERB::Util.url_encode(return_to_value)}" if return_to_value.present? %>
    <% if pending_resubmission_token_value.present? %>
      <% github_auth_url += "&pending_resubmission_token=#{ERB::Util.url_encode(pending_resubmission_token_value)}" %>
    <% end %>
    <%= link_to Icon[:'fa-github'] + t('sessions.login_with_github_html'),
                github_auth_url,
                class: 'btn btn-lg btn-social btn-github btn-block',
                method: 'post' %>
    <br><br>
    <%= t('sessions.login_automatic_signup') %>
    <br><br>
    <div class='text-center h2'>- <%= t('sessions.or') %> -</div>
    <br><br>
   </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6 col-md-offset-3">
    <%= form_for(:session, url: login_path) do |f| %>

      <%= f.label :email, t('sessions.email') %>
      <%= f.email_field :email, class: 'form-control' %>

      <%= f.label :password, t('sessions.password') %>
      <%= link_to t('sessions.forgot_password'), new_password_reset_path %>
      <%= f.password_field :password, autocomplete: 'off', class: 'form-control' %>

      <%= f.label :remember_me, t('sessions.remember_me'),
                  class: "checkbox inline" do %>
        <%= f.check_box :remember_me %>
        <span><%= t('sessions.remember_me') %>
              <%= t('sessions.cookie_details_html') %></span>
      <% end %>

      <%= f.hidden_field :provider, value: "local" %>
      <%= f.hidden_field :return_to, value: return_to_value if return_to_value.present? %>
      <%= f.hidden_field :pending_resubmission_token,
                         value: pending_resubmission_token_value if
                         pending_resubmission_token_value.present? %>
      <%= f.submit t('sessions.login_custom'), class: "btn btn-lg btn-primary" %>
    <% end %>

    <br><br>
    <%= link_to t('sessions.no_custom'), signup_path %>
    <br>
    <br>
  </div>
</div>
<% end %>
